# ====================================================================
# ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to .env.local and fill in your actual values
#
# LOCAL DEVELOPMENT SETUP:
# ------------------------
# 1. Create a .env.local file (git-ignored)
# 2. Copy all sections below
# 3. Fill in required API keys for features you want to use
# 4. Run: npm run dev
#
# PRODUCTION SETUP:
# -----------------
# 1. Create Vercel project
# 2. Link to GitHub repo
# 3. Add all environment variables in Vercel Dashboard
# 4. For Vercel KV/Blob: Create storage in Vercel Dashboard and connect to project
# 5. Pull env vars locally: npx vercel env pull .env.local
#
# ====================================================================

# --------------------------------------------------------------------
# REQUIRED: OpenAI API (for chatbot GPT-4.1-mini and embeddings)
# --------------------------------------------------------------------
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# --------------------------------------------------------------------
# REQUIRED: Pinecone Vector Database (for RAG document search)
# --------------------------------------------------------------------
# Get from: https://app.pinecone.io/
# 1. Create index with 3072 dimensions (text-embedding-3-large)
# 2. Use cosine similarity metric
#
# NOTE (2026-05): Migrated từ text-embedding-3-small → text-embedding-3-large
# vì OpenAI deprecated text-embedding-3-small (shutdown Oct 23, 2026).
# Index mới phải dùng 3072 dims thay vì 1536.
#
# ENVIRONMENT SEPARATION:
# - Production: Use index "hungreo-website-v2"
# - Development: Use index "hungreo-website-v2" (same — personal project)
#
PINECONE_API_KEY=your-api-key-here
PINECONE_INDEX_NAME=hungreo-website-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --------------------------------------------------------------------
# REQUIRED: YouTube Data API v3 (for YouTube video analysis)
# --------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIzaSy-your-key-here

# --------------------------------------------------------------------
# REQUIRED: NextAuth v5 (for admin authentication)
# --------------------------------------------------------------------
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# Admin credentials
ADMIN_EMAIL=hungreo2005@gmail.com
# Generate hash with: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('your-password', 10).then(h => console.log(h))"
# Default hash is for password: admin123
ADMIN_PASSWORD_HASH=$2b$10$05KUDdTtAhvYELphZhxeUOQZ0tNy08ACVz64jOJbLuSwJXW0gMSAK

# --------------------------------------------------------------------
# OPTIONAL: Chrome Path for Puppeteer (Local Development Only)
# --------------------------------------------------------------------
# Puppeteer needs Chrome/Chromium to scrape website content for RAG
# This is only needed for LOCAL DEVELOPMENT - production uses @sparticuz/chromium
#
# Platform-specific Chrome installation paths:
#
# MacOS (default - will be used if not set):
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#
# Windows:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
#
# Linux (Ubuntu/Debian):
# CHROME_PATH=/usr/bin/google-chrome
#
# Linux (Chromium):
# CHROME_PATH=/usr/bin/chromium-browser
#
# Production (Vercel):
# - Automatically uses @sparticuz/chromium
# - No CHROME_PATH configuration needed
#
# If CHROME_PATH is not set:
# - Falls back to MacOS default path
# - May fail on Windows/Linux systems
# - Install Chrome and set the correct path for your OS

# --------------------------------------------------------------------
# OPTIONAL: Vercel KV (for document management & chat logging)
# --------------------------------------------------------------------
# Setup:
# 1. Go to Vercel Dashboard → Storage → Create KV Database
# 2. Connect to your project
# 3. Run: npx vercel env pull .env.local (to get these values)
#
# ENVIRONMENT SEPARATION (RECOMMENDED):
# - Production: Use "large-heron-11467" database
# - Development: Use "intent-peacock-38586" database (already created)
# - IMPORTANT: Always use development database in .env.local
# - This prevents test data from contaminating production
#
# Local Development:
# - If not configured: Uses in-memory storage (data lost on restart)
# - If configured: Uses Vercel KV (data persists, works in localhost)
#
# Get these from: Vercel Dashboard → Storage → KV → .env.local tab
KV_REST_API_URL=https://intent-peacock-38586.upstash.io
KV_REST_API_TOKEN=your-dev-token-here
UPSTASH_REDIS_REST_URL=https://intent-peacock-38586.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-dev-token-here

# --------------------------------------------------------------------
# OPTIONAL: Vercel Blob Storage (for large file uploads >4.5MB)
# --------------------------------------------------------------------
# Setup:
# 1. Go to Vercel Dashboard → Storage → Create Blob Storage
# 2. Connect to your project
# 3. Run: npx vercel env pull .env.local (to get this value)
#
# ENVIRONMENT SEPARATION (SHARED):
# - Decision: Using shared blob storage for both environments
# - Single developer project - manageable with naming convention
# - Best Practice: Prefix test files with "test-" or "dev-"
# - Regularly clean up test files from Vercel dashboard
#
# Local Development Limitation:
# - File uploads work, but callbacks (onUploadCompleted) won't trigger
# - For full functionality: Use ngrok to tunnel localhost or deploy to Vercel
#
# Get from: Vercel Dashboard → Storage → Blob → .env.local tab
BLOB_READ_WRITE_TOKEN=your-blob-token-here

# --------------------------------------------------------------------
# OPTIONAL: Resend (for email notifications)
# --------------------------------------------------------------------
# Get from: https://resend.com/api-keys
# If not configured: Email notifications are skipped silently
RESEND_API_KEY=re_your-api-key-here
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_TO_EMAIL=hungreo2005@gmail.com

# --------------------------------------------------------------------
# OPTIONAL: Analytics
# --------------------------------------------------------------------
# Get from: Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
