# ====================================================================
# ENVIRONMENT CONFIGURATION
# ====================================================================
# Copy this file to .env.local and fill in your actual values
#
# LOCAL DEVELOPMENT SETUP:
# ------------------------
# 1. Create a .env.local file (git-ignored)
# 2. Copy all sections below
# 3. Fill in required API keys for features you want to use
# 4. Run: npm run dev
#
# PRODUCTION SETUP:
# -----------------
# 1. Create Vercel project
# 2. Link to GitHub repo
# 3. Add all environment variables in Vercel Dashboard
# 4. For Vercel KV/Blob: Create storage in Vercel Dashboard and connect to project
# 5. Pull env vars locally: npx vercel env pull .env.local
#
# ====================================================================

# --------------------------------------------------------------------
# REQUIRED: NextAuth v5 (for admin authentication)
# --------------------------------------------------------------------
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# Admin credentials
ADMIN_EMAIL=admin@minhtran-portfolio.com
# Generate hash with: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('your-password', 10).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=$2b$10$your-hash-here

# --------------------------------------------------------------------
# REQUIRED: Site URL
# --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://minhtran-portfolio.vercel.app

# --------------------------------------------------------------------
# OPTIONAL: Vercel KV (for contact request logging & visitor tracking)
# --------------------------------------------------------------------
# Setup:
# 1. Go to Vercel Dashboard → Storage → Create KV Database
# 2. Connect to your project
# 3. Run: npx vercel env pull .env.local (to get these values)
#
# Get these from: Vercel Dashboard → Storage → KV → .env.local tab
KV_REST_API_URL=https://your-kv-url.kv.vercel-storage.com
KV_REST_API_TOKEN=your-token-here

# --------------------------------------------------------------------
# OPTIONAL: Vercel Blob Storage (for large file uploads >4.5MB)
# --------------------------------------------------------------------
# Setup:
# 1. Go to Vercel Dashboard → Storage → Create Blob Storage
# 2. Connect to your project
# 3. Run: npx vercel env pull .env.local (to get this value)
#
# Get from: Vercel Dashboard → Storage → Blob → .env.local tab
BLOB_READ_WRITE_TOKEN=your-blob-token-here

# --------------------------------------------------------------------
# OPTIONAL: Resend (for email notifications on contact requests)
# --------------------------------------------------------------------
# Get from: https://resend.com/api-keys
# If not configured: Email notifications are skipped silently
RESEND_API_KEY=re_your-api-key-here
EMAIL_FROM=noreply@yourdomain.com
ADMIN_EMAIL=admin@minhtran-portfolio.com
