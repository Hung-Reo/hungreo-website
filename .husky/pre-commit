#!/usr/bin/env sh
# No husky.sh source: husky is not a dependency, so .husky/_/husky.sh never
# exists and sourcing it aborted every commit.

echo "🔍 Running pre-commit security checks..."

# Env files hold real keys; only the placeholder template may be committed.
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$')
if [ -n "$ENV_FILES" ]; then
  echo "❌ ERROR: Env file staged for commit:"
  echo "$ENV_FILES"
  echo "   Unstage it: git restore --staged <file>"
  exit 1
fi

# Only added lines, so deleting a leaked key is never blocked.
ADDED=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+ ')

# Check for exposed passwords
if git diff --cached --name-only | grep -E '\.(md|txt)$' > /dev/null; then
  echo "📝 Checking markdown files for exposed secrets..."

  if git diff --cached -U0 --no-color -- '*.md' '*.txt' | grep -E '^\+' | grep -E "Admin@123|Password: \`[A-Za-z0-9!@#$%^&*]{8,}\`"; then
    echo "❌ ERROR: Found exposed passwords in staged files!"
    echo "   Please remove passwords before committing."
    exit 1
  fi
fi

# Key patterns apply to every file type (code, config, docs).
if echo "$ADDED" | grep -E "UPSTASH_REDIS_REST_TOKEN=A[a-zA-Z0-9]{50,}"; then
  echo "❌ ERROR: Found real Upstash token in staged files!"
  echo "   Please use placeholder instead: YOUR_UPSTASH_TOKEN_HERE"
  exit 1
fi

if echo "$ADDED" | grep -E "sk-[a-zA-Z0-9_-]{40,}|AIza[a-zA-Z0-9_-]{35,}|re_[a-zA-Z0-9]{30,}|gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{60,}|-----BEGIN [A-Z ]*PRIVATE KEY-----"; then
  echo "❌ ERROR: Found API keys in staged files!"
  echo "   Please remove API keys before committing."
  exit 1
fi

echo "✅ Security checks passed!"
